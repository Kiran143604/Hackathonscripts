@app.route('/')
def index():
    return render_template('index.html')  # Your HTML file goes in templates folder

@app.route('/predict', methods=['POST'])
def predict():
    data = request.get_json()
    required_fields = [
        'auditor_location_distance', 'auditor_availability', 'auditor_skill_level',
        'store_risk_score', 'audit_priority', 'traffic_condition',
        'weather_condition', 'audit_deadline_hours', 'store_open_status'
    ]

    # Validate input
    for field in required_fields:
        if field not in data:
            return jsonify({'error': f'Missing field: {field}'}), 400

    # Prepare input for model
    input_df = pd.DataFrame([{
        'auditor_location_distance': data['auditor_location_distance'],
        'auditor_availability': data['auditor_availability'],
        'auditor_skill_level': data['auditor_skill_level'],
        'store_risk_score': data['store_risk_score'],
        'audit_priority': data['audit_priority'],
        'traffic_condition': data['traffic_condition'],
        'weather_condition': data['weather_condition'],
        'audit_deadline_hours': data['audit_deadline_hours'],
        'store_open_status': data['store_open_status']
    }])

    prediction = int(model.predict(input_df)[0])
    probability = round(model.predict_proba(input_df)[0][1], 4)

    # Heuristic score (same as your logic)
    score = 0
    if data['auditor_availability'] == 0: score += 2
    if data['auditor_location_distance'] > 30: score += 1
    if data['store_risk_score'] > 7: score += 1
    if data['audit_priority'] > 3: score += 1
    if data['traffic_condition'] == 1 or data['weather_condition'] == 1: score += 1
    if data['audit_deadline_hours'] < 4: score += 1
    if data['store_open_status'] == 0: score += 2

    # Reassignment logic
    reassignment_triggered = prediction == 1
    new_shop = "Shop B" if reassignment_triggered else None

    return jsonify({
        'prediction': prediction,
        'prediction_label': 'Yes, Reassignment Needed' if prediction == 1 else 'No, Auditor Stays',
        'probability_of_reassignment': probability,
        'heuristic_score': score,
        'reassignment': {
            'reassignment_triggered': reassignment_triggered,
            'new_shop': new_shop
        }
    })

